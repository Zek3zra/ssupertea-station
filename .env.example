# Ssupertea Station — Vercel Environment Variables
# Keep real secret values only in Vercel. Never commit them to Git.

# OpenRouteService — server-side only.
OPENROUTESERVICE_API_KEY=

# ArcGIS basemap key. This key is intentionally used by the browser map,
# so restrict it in ArcGIS to the Ssupertea site referrer and Basemaps privileges only.
ARCGIS_API_KEY=

# Supabase backend configuration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Shop / delivery configuration.
SSUPERTEA_SHOP_LAT=10.406125231986707
SSUPERTEA_SHOP_LNG=122.9977403682195
SSUPERTEA_SHOP_NAME=Ssupertea Station
SSUPERTEA_MAX_ROUTE_KM=50

# Browser Supabase configuration is stored in js/supabase-config.js.
# Use only the Supabase sb_publishable_... key there. Never place an
# sb_secret_... or legacy service_role key in browser code.
